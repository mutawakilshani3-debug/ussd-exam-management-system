# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ussd_db

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Default Administrator (used by seed script, only runs once)
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=admin@ckt-utas.edu.gh
ADMIN_PHONE=0500000000
ADMIN_PASSWORD=ChangeMe@123

# Email (Nodemailer - optional, leave blank to disable emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=USSD Exam System <no-reply@ckt-utas.edu.gh>
# SMS (Africa's Talking - optional, leave blank to disable SMS)
AT_USERNAME=
AT_API_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
